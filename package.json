{
  "name": "@sustenaut/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sustenaut's React components: presentation only, no data fetching or business rules; form bindings for react-hook-form and renderers for JSON Forms.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./jsonforms": "./src/jsonforms/index.tsx",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" vitest.config.ts",
    "check-format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" vitest.config.ts",
    "unit": "vitest run --coverage",
    "test": "npm run typecheck && npm run check-format && npm run unit"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-hook-form": "^7.89.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@jsonforms/core": "3.8.0",
    "@jsonforms/react": "3.8.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sustenaut/ui.git"
  }
}
