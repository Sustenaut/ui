{
  "name": "@sustenaut/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sustenaut's React components: presentation only, no data fetching or business rules; form bindings for react-hook-form.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "check-format": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "npm run typecheck && npm run check-format"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-hook-form": "^7.89.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "^5.9.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sustenaut/ui.git"
  }
}
